# Supabase Project URL & Anonymous Public Key
# When left empty, the application runs in local IndexedDB offline mode with full functionality.
# When provided, the store connects directly to your Supabase PostgreSQL instance.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Booking WhatsApp number, international format, no +. Defaults to 2347065086445 if unset.
VITE_WHATSAPP_PHONE=2347065086445
